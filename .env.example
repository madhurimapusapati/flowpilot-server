# Copy this to .env and fill in your values
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/flowpilot?retryWrites=true&w=majority
JWT_SECRET=<generate-a-long-random-string-min-32-chars>
CLIENT_URL=https://<your-frontend-railway-url>.railway.app
ADMIN_SECRET_KEY=<secret-key-only-admins-know>
